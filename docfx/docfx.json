{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src/MiPdf",
          "files": [
            "MiPdf.csproj"
          ]
        },
        {
          "src": "../src/MiPdf.Rendering",
          "files": [
            "MiPdf.Rendering.csproj"
          ]
        },
        {
          "src": "../src/MiPdf.PostScript",
          "files": [
            "MiPdf.PostScript.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net8.0"
      },
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "index.md",
          "toc.yml",
          "docs/toc.yml"
        ]
      },
      {
        "files": [
          "guide/*.md",
          "howto/*.md",
          "COMPARISON.md",
          "MIGRATION.md",
          "ARCHITECTURE.md"
        ],
        "src": "../docs",
        "dest": "docs"
      }
    ],
    "resource": [
      {
        "files": [
          "images/*.png"
        ]
      },
      {
        "files": [
          "social-preview.png"
        ],
        "src": "../assets",
        "dest": "images"
      },
      {
        "files": [
          "*.html",
          "*.xml"
        ],
        "src": "verification"
      }
    ],
    "output": "_site",
    "sitemap": {
      "baseUrl": "https://mibuw.github.io/miPDFlib/",
      "changefreq": "weekly",
      "priority": 0.5,
      "fileOptions": {
        "index.md": { "priority": 1.0 },
        "../docs/**.md": { "priority": 0.8 }
      }
    },
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_appName": "miPDFlib",
      "_appTitle": "miPDFlib",
      "_description": "miPDFlib: open-source PDF library for .NET 8/10 (Apache-2.0) – create, edit, fill forms, sign (PAdES), PDF/A, PDF/UA, ZUGFeRD, text extraction with layout analysis and export to Markdown, rendering. No native dependencies.",
      "_appLogoPath": "images/logo.png",
      "_appFaviconPath": "images/favicon.png",
      "_appFooter": "miPDFlib – Apache-2.0 – <a href=\"https://github.com/Mibuw/miPDFlib\">GitHub</a> · <a href=\"https://www.nuget.org/packages/miPDFlib\">NuGet</a>",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/Mibuw/miPDFlib",
        "branch": "main"
      },
      "pdf": false
    }
  }
}
