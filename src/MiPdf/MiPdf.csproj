<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>MiPdf</RootNamespace>
    <AssemblyName>MiPdf</AssemblyName>
    <PackageId>miPDFlib</PackageId>
    <Version>0.3.0</Version>
    <Description>Open-source (Apache-2.0) PDF library for .NET: create, read, modify, merge, fill forms, encrypt and digitally sign PDF documents.</Description>
    <PackageTags>pdf;pdf-library;pdf-generation;pdf-signature;digital-signature;pades;eidas;ltv;pdfa;pdf-ua;tagged-pdf;acroform;redaction;text-extraction;zugferd;factur-x;xrechnung;barcode;qrcode;itext-alternative</PackageTags>
    <!-- nuget.org renders no HTML, so the package has its own Markdown-only readme (UTF-8 with BOM) -->
    <PackageReadmeFile>NUGET-README.md</PackageReadmeFile>
    <PackageIcon>miPDFlib_logo.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- NuGet / SourceLink (built into the .NET 8+ SDK) -->
    <PackageProjectUrl>https://github.com/Mibuw/miPDFlib</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <None Include="NUGET-README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\miPDFlib_logo.png" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="MiPdf.Tests" />
  </ItemGroup>

</Project>
