<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>MiPdf.PostScript</RootNamespace>
    <AssemblyName>MiPdf.PostScript</AssemblyName>
    <PackageId>miPDFlib.PostScript</PackageId>
    <Version>1.3.0</Version>
    <Description>Converts PostScript and EPS to PDF and places EPS graphics in PDF documents. Pure managed code for .NET 8/10 without native dependencies, based on miPDFlib (Apache-2.0).</Description>
    <PackageTags>pdf;postscript;eps;ps2pdf;eps-to-pdf;ps-to-pdf</PackageTags>
    <PackageReadmeFile>NUGET-README.md</PackageReadmeFile>
    <PackageIcon>miPDFlib_logo.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageProjectUrl>https://github.com/Mibuw/miPDFlib</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiPdf\MiPdf.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="NUGET-README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\miPDFlib_logo.png" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="MiPdf.Tests" />
  </ItemGroup>

  <!-- the converter uses internals of miPDFlib: depend on exactly the same version -->
  <Target Name="PinMiPdfVersion" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(ProjectVersion)]" />
    </ItemGroup>
  </Target>

</Project>
